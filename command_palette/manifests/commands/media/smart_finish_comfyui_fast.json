{
  "id": "media.smart_finish_comfyui_fast",
  "display_name": "Smart Finish — ComfyUI Fast Model",
  "aliases": ["comfyui fast upscale", "fast ai upscale", "fast video enhance", "tiny realesrgan"],
  "tags": ["media", "video", "comfyui", "upscale", "fast", "local"],
  "category": "media",
  "description": "Fast local Real-ESRGAN General x4v3 model with pinned official weights, source FPS/audio verification and one quality-first H.264 delivery encode. Fine-detail quality may be lower than the quality-first model.",
  "worker_type": "python",
  "worker_entry": "sscp.workers.smart_finish.main",
  "script_path": "command_palette/workers/python/src/sscp/workers/smart_finish/main.py",
  "arguments": {"backend_id": "comfyui-gan", "model_id": "auto-fast", "quality_policy": "fastest_safe", "compression_profile": "quality", "final_long_edge": 3840},
  "selected_file_requirements": {
    "required": true, "allow_files": true, "allow_folders": false,
    "extensions": [".mp4", ".mov", ".mkv", ".m4v", ".webm"],
    "min_count": 1, "max_count": 1, "preserve_order": true
  },
  "queue_behavior": {"mode": "single_command", "dedupe": "request_key"},
  "progress_behavior": {"mode": "job_json", "show_overlay": true, "allow_cancel": true},
  "sound_profile": "video_upscale_done",
  "platform_support": ["win10", "win11"],
  "confirmation_required": false,
  "danger_level": "safe",
  "output_folder_behavior": "open_primary_output_folder"
}
