{
  "id": "media.smart_finish_comfyui",
  "display_name": "Smart Finish — ComfyUI AI Upscale",
  "aliases": ["comfyui upscale", "ai video upscaling comfyui", "real esrgan video", "6k ai upscale", "alternate upscaling"],
  "tags": ["media", "video", "comfyui", "upscale", "quality", "local"],
  "category": "media",
  "description": "Real local ComfyUI Real-ESRGAN enhancement, preserving source FPS and all audio tracks, followed by one quality-preserving MP4 encode. Input must be SDR CFR; this frame model is not temporally trained VSR.",
  "worker_type": "python",
  "worker_entry": "sscp.workers.smart_finish.main",
  "script_path": "command_palette/workers/python/src/sscp/workers/smart_finish/main.py",
  "arguments": {"backend_id": "comfyui-gan", "model_id": "auto-quality", "quality_policy": "best_quality", "compression_profile": "quality", "final_long_edge": 3840},
  "selected_file_requirements": {
    "required": true,
    "allow_files": true,
    "allow_folders": false,
    "extensions": [".mp4", ".mov", ".mkv", ".m4v", ".webm"],
    "min_count": 1,
    "max_count": 1,
    "preserve_order": true
  },
  "queue_behavior": {"mode": "single_command", "dedupe": "request_key"},
  "progress_behavior": {"mode": "job_json", "show_overlay": true, "allow_cancel": true},
  "sound_profile": "video_upscale_done",
  "platform_support": ["win10", "win11"],
  "confirmation_required": false,
  "danger_level": "safe",
  "output_folder_behavior": "open_primary_output_folder"
}
