{
  "id": "media.smart_finish_best_quality",
  "display_name": "Smart Finish — Best Available Detail",
  "aliases": ["smart finish best quality", "best available upscale", "maximum useful detail", "4K best detail"],
  "tags": ["media", "video", "upscale", "quality", "topaz"],
  "category": "media",
  "description": "Process one selected finished video using its highest admitted local Topaz working resolution and matching retained master. The native 4K model path has a known unresolved vendor crash; this command does not promise 6K AI reconstruction.",
  "worker_type": "python",
  "worker_entry": "sscp.workers.smart_finish.main",
  "script_path": "command_palette/workers/python/src/sscp/workers/smart_finish/main.py",
  "arguments": {"quality_policy": "best_quality", "apply_recommendation": true, "output_fps": 60, "compression_profile": "quality"},
  "selected_file_requirements": {
    "required": true,
    "allow_files": true,
    "allow_folders": false,
    "extensions": [".mp4", ".mov", ".mkv", ".m4v", ".webm", ".avi", ".mxf"],
    "min_count": 1,
    "max_count": 1,
    "preserve_order": true
  },
  "queue_behavior": {"mode": "single_command", "dedupe": "request_key"},
  "progress_behavior": {"mode": "job_json", "show_overlay": true, "allow_cancel": true},
  "sound_profile": "video_upscale_done",
  "platform_support": ["win10", "win11"],
  "confirmation_required": false,
  "danger_level": "safe",
  "output_folder_behavior": "open_primary_output_folder"
}
